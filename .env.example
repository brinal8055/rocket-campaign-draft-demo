ENVIRONMENT=local
LOG_LEVEL=INFO
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_STRATEGY_MODEL=gpt-5.4
OPENAI_TRANSFORM_MODEL=gpt-5-mini
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_PROJECT=rocket-campaign-draft-demo
LANGSMITH_TRACING=true
# LANGSMITH_WORKSPACE_ID=<optional-workspace-id>
GOOGLE_ADS_DEVELOPER_TOKEN=<your-google-ads-developer-token>
GOOGLE_ADS_CLIENT_ID=<your-google-oauth-client-id>
GOOGLE_ADS_CLIENT_SECRET=<your-google-oauth-client-secret>
GOOGLE_ADS_REFRESH_TOKEN=<your-google-oauth-refresh-token>
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_USE_TEST_ACCOUNT=true
N8N_APPROVAL_WEBHOOK_URL=https://n8n.example.com/webhook/approval
